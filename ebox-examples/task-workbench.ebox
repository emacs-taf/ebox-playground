'(box :id "task-app" :class "task-app"
      :ecss (("&" :color "#17324D" :background-color "#EAF4FF")
             ("& > .topbar" :color "#FFFFFF" :background-color "#17324D" :font-weight bold)
             (".column" :background-color "#D6EAF8" :color "#102A43")
             (".column.todo" :background-color "#FFF4CC")
             (".column.doing" :background-color "#D9E8FF")
             (".column.archived" :background-color "#E3E7EB" :color "#52606D")
             (".column > .card:first-child" :background-color "#FFE08A" :color "#5C3B00" :font-weight bold)
             (".column > .card:nth-child(2n)" :background-color "#BDEFE2")
             (".card:last-child" :border-bottom-width (px 2))
             (".column > .card.active" :color "#075E1B" :background-color "#8FF0A4" :font-weight bold)
             (".column > .card:not(.active)" :color "#174A70")
             (".card + .card" :border-top-width (px 1))
             (".column:has(.card.active)" :color "#075E1B" :border-left-color "#075E1B")
             (".column:is(.todo, .doing)" :border-top-color "#2080D0")
             (".column:not(.archived) .card" :border-left-color "#2080D0")
             ("[data-priority=urgent]" :color "#B00020" :font-weight bold)
             ("[data-label~=backend]" :color "#7030A0")
             ("#release-card" :color "#FFFFFF" :background-color "#7030A0" :font-weight bold)
             (".zh:lang(zh)" :font-weight bold)
             (".rtl:dir(rtl)" :color "#8A2BE2"))
      (box :class "topbar" "Task Workbench | team delivery queue")
      (box :class '("column" "todo")
           (box "TODO | first card gets pale yellow")
           (box :class "card" :attributes (("data-priority" . "urgent"))
                "Fix parser bug | urgent")
           (box :class '("card" "zh")
                :attributes (("data-label" . "backend api") ("lang" . "zh-CN"))
                "接口文档 | :lang(zh) and backend label"))
      (box :class '("column" "doing")
           (box "DOING | has active card | blue top edge")
           (box :class '("card" "active") "Implement scope cascade | active")
           (box :id "release-card" :class "card" "Release 0.2 | ID wins")
           (box :class "card"
                :attributes (("dir" . "rtl"))
                "مراجعة واجهة المستخدم | :dir(rtl)"))
      (box :class '("column" "archived")
           (box "ARCHIVED | excluded by :not(.archived)")
           (box :class "card" "Old migration note | archived")))
